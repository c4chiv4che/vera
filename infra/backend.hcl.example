# Copy to backend.hcl.local and replace <ACCOUNT_ID> with your AWS account ID.
# Then run: terraform init -backend-config=backend.hcl.local
bucket         = "vera-tf-state-<ACCOUNT_ID>"
key            = "infra/terraform.tfstate"
region         = "us-east-1"
dynamodb_table = "vera-tf-locks"
encrypt        = true
