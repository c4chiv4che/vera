# ============================================================================
# Docker build context exclusions for vera
# ============================================================================
# The gateway image needs:
#   - agent/app/vera/pyproject.toml
#   - agent/app/vera/uv.lock
#   - agent/app/vera/   (the source tree)
#
# Everything else gets stripped from the build context to keep
# "Sending build context to Docker daemon" fast (~2.5GB of repo state
# excluded; effective context ~100-200MB).
# ============================================================================

# Git history — not needed inside the container
.git/
.gitignore
.gitattributes

# Python build artifacts
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
**/.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node toolchain — CDK and frontend, neither runs in the gateway container
node_modules/
**/node_modules/

# Frontend — separate component, not in the gateway
frontend/

# AgentCore — separate CDK-based component, not in the gateway
agent/agentcore/

# Infra — Terraform stacks (.terraform/, state) never go in the container
infra/

# BFF — separate backend, not in the gateway
bff/

# Docs — markdown lives in main, not in container
docs/

# Local tooling / scratch
tmp/
.idea/
.vscode/
*.local
**/*.local

# OS junk
.DS_Store
Thumbs.db

# Logs
*.log

# Docker itself — avoid recursing the Dockerfile into the context
# (it stays available as the -f target, just not as a COPY source)
.dockerignore
